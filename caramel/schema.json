{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Lynxifyy/Bedrock-Offsets/caramel/schema.json",
  "title": "CaramelClient offset pack",
  "description": "One file per Minecraft version. Every item CaramelClient needs is present: resolved items carry an address, unresolved items carry status 'missing' and the attempts that failed.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedBy",
    "version",
    "engineVersion",
    "library",
    "groups",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedBy": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string" },
    "library": {
      "type": "object",
      "required": ["sha256", "size", "arch"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "groups": {
      "type": "object",
      "required": ["access_chain", "entity_list", "ecs"],
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/entry" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "found", "partial", "missing", "by_confidence"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "found": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "by_confidence": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "definitions": {
    "hex": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
    "entry": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "group",
        "status",
        "confidence",
        "rva",
        "file_offset",
        "how_found",
        "evidence",
        "why"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["class_vtable", "function", "member", "global", "constant"] },
        "group": { "type": "string", "minLength": 1 },
        "status": { "enum": ["found", "partial", "missing"] },
        "confidence": { "enum": ["certain", "likely", "guess", "none"] },
        "rva": { "oneOf": [{ "$ref": "#/definitions/hex" }, { "type": "null" }] },
        "file_offset": { "oneOf": [{ "$ref": "#/definitions/hex" }, { "type": "null" }] },
        "how_found": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "why": { "type": "string", "minLength": 1 },
        "tried": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "found" } } },
          "then": {
            "properties": {
              "rva": { "$ref": "#/definitions/hex" },
              "confidence": { "enum": ["certain", "likely", "guess"] }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "missing" } } },
          "then": {
            "properties": {
              "rva": { "type": "null" },
              "file_offset": { "type": "null" },
              "confidence": { "const": "none" },
              "tried": { "type": "array", "minItems": 1 }
            },
            "required": ["tried"]
          }
        }
      ]
    }
  }
}
